# EMBERWISE M3 targets. Include from the root Makefile (M1 owns it):  include Makefile.tables
# One command for M3's work:  make tables
PY ?= python3
HANDOFF = data/processed/tile_day.parquet

.PHONY: tables mocks schema check size test-tables

# Until M1/M2 hand off real files, the hand-offs are mocks. Real files in place => same command.
$(HANDOFF):
	$(PY) -m pipeline.tables.make_mocks

mocks:
	$(PY) -m pipeline.tables.make_mocks

tables: $(HANDOFF)
	$(PY) -m pipeline.tables.build_tables
	$(PY) -m pipeline.tables.gen_schema_md
	$(PY) -m pipeline.tables.check_contract
	$(PY) -m pipeline.tables.size_report

schema:
	$(PY) -m pipeline.tables.gen_schema_md

check:
	$(PY) -m pipeline.tables.check_contract

size:
	$(PY) -m pipeline.tables.size_report

test-tables: tables
	$(PY) -m pytest -q tests/test_tables_stage_a.py
